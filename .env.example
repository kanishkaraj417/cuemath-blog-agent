# Copy this file to cuemath/.env and fill in your own values.
# Never commit or share the filled-in .env file — these are personal API credentials.

# Ghost Admin API key for cuemath.com/blog.
# Get yours: Ghost Admin -> Settings -> Integrations -> (your custom integration) -> Admin API Key
GHOST_URL=https://www.cuemath.com/blog
GHOST_ADMIN_API_KEY=

# Rebrandly — used when creating cuemath.link short links for CTAs (Stage 4, Step B3).
# Get your API key: Rebrandly dashboard -> Account Settings -> API Keys
# Domain ID: Rebrandly dashboard -> Domains -> cuemath.link -> copy its ID
REBRANDLY_API_KEY=
REBRANDLY_DOMAIN_ID=

# Ahrefs MCP server auth (used for keyword research in Stage 2A).
# Get yours from your Ahrefs account -> API access.
AHREFS_TOKEN=
